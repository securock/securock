{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://securock.dev/schema/chain-report.schema.json",
  "title": "securock chain report",
  "type": "object",
  "additionalProperties": false,
  "required": ["tool", "chains"],
  "properties": {
    "tool": { "const": "chain" },
    "chains": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "status", "summary", "nodes"],
        "properties": {
          "id": { "type": "string", "pattern": "^chain:[0-9]+$" },
          "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
          "status": { "enum": ["confirmed", "possible"] },
          "summary": { "type": "string", "minLength": 1 },
          "nodes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["finding", "stage"],
              "properties": {
                "finding": { "type": "string", "pattern": "^sast:" },
                "stage": { "enum": ["entry", "pivot", "impact"] },
                "subject": { "type": "string" },
                "detail": { "type": "string" },
                "location": { "$ref": "#/$defs/location" }
              }
            }
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["from", "to", "status", "reason"],
              "properties": {
                "from": { "type": "integer", "minimum": 0 },
                "to": { "type": "integer", "minimum": 0 },
                "status": { "enum": ["confirmed", "possible"] },
                "reason": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "line"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
