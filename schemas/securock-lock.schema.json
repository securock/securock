{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://securock.dev/schema/securock-lock.schema.json",
  "title": "securock.lock",
  "type": "object",
  "required": ["version", "artifacts"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ecosystems": {
          "type": "array",
          "items": { "type": "string", "enum": ["npm", "jsr", "url", "cargo", "go", "pypi"] },
          "uniqueItems": true
        },
        "resolvers": {
          "type": "array",
          "items": { "type": "string", "enum": ["npm", "pnpm", "yarn", "bun", "deno", "cargo", "go", "uv", "poetry"] },
          "uniqueItems": true
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "digest": { "type": "string" }
      }
    },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["subject", "version", "evidence", "trust"],
      "additionalProperties": false,
      "properties": {
        "subject": { "$ref": "#/$defs/subject" },
        "version": { "type": "string", "minLength": 1 },
        "filename": { "type": "string" },
        "digest": { "type": "string" },
        "source": { "$ref": "#/$defs/artifactSource" },
        "evidence": { "$ref": "#/$defs/evidence" },
        "trust": { "$ref": "#/$defs/trust" }
      }
    },
    "subject": {
      "type": "object",
      "required": ["ecosystem", "name"],
      "additionalProperties": false,
      "properties": {
        "ecosystem": {
          "type": "string",
          "enum": ["npm", "jsr", "url", "cargo", "go", "pypi"]
        },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "artifactSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resolver": {
          "type": "string",
          "enum": ["npm", "pnpm", "yarn", "bun", "deno", "cargo", "go", "uv", "poetry"]
        },
        "registry": { "type": "string" }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["provenance", "signature", "vulnerabilities"],
      "additionalProperties": false,
      "properties": {
        "provenance": { "$ref": "#/$defs/evidenceState" },
        "signature": { "$ref": "#/$defs/evidenceState" },
        "vulnerabilities": { "$ref": "#/$defs/vulnEvidence" }
      }
    },
    "vulnEvidence": {
      "type": "object",
      "required": ["state"],
      "additionalProperties": false,
      "properties": {
        "state": { "type": "string", "enum": ["unknown", "checked"] },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/vulnerability" }
        }
      }
    },
    "vulnerability": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "trust": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": ["trusted", "untrusted", "unknown"]
        },
        "reasons": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "evidenceState": {
      "type": "string",
      "enum": ["unknown", "missing", "present", "verified"]
    }
  }
}
