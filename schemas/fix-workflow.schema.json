{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://securock.dev/schema/fix-workflow.schema.json",
  "type": "object",
  "required": [
    "version",
    "branch",
    "files",
    "tests",
    "revision",
    "verified"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "branch": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "integer",
      "minimum": 0
    },
    "revision": {
      "type": "string"
    },
    "verified": {
      "type": "boolean"
    }
  }
}
