{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://securock.dev/schema/credential-report.schema.json",
  "type": "object",
  "required": [
    "version",
    "provider",
    "action",
    "state"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "provider": {
      "enum": [
        "github",
        "gitlab"
      ]
    },
    "action": {
      "enum": [
        "check",
        "rotate",
        "revoke"
      ]
    },
    "state": {
      "enum": [
        "unknown",
        "active",
        "inactive",
        "revoked",
        "rotated"
      ]
    }
  }
}
