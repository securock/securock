{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://securock.dev/schema/inventory-report.schema.json",
  "type": "object",
  "required": [
    "version",
    "nodes",
    "edges",
    "gaps"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "digest": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "relation",
          "evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "relation": {
            "type": "string"
          },
          "evidence": {
            "enum": [
              "declared",
              "observed",
              "verified"
            ]
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
