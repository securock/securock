{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://securock.dev/schema/organization-report.schema.json",
  "type": "object",
  "required": [
    "version",
    "service",
    "report",
    "tasks",
    "criticality"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "service": {
      "type": "string"
    },
    "report": {
      "type": "object",
      "required": [
        "tool",
        "findings"
      ]
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "owner",
          "due",
          "priority"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "due": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "priority": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "criticality": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    }
  }
}
