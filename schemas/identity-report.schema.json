{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://securock.dev/schema/identity-report.schema.json",
  "type": "object",
  "required": [
    "subject",
    "tenant",
    "roles"
  ],
  "additionalProperties": false,
  "properties": {
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "tenant": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,128}$"
    },
    "roles": {
      "type": "array",
      "items": {
        "enum": [
          "admin",
          "reader",
          "developer",
          "reviewer",
          "runner",
          "provisioner"
        ]
      }
    }
  }
}
